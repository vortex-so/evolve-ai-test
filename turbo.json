{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "dependsOn": ["build", "typecheck"],
      "cache": false
    },
    "db:generate": {
      "cache": false,
      "outputs": ["drizzle/**", "migrations/**"]
    },
    "db:migrate:local": {
      "cache": false,
      "dependsOn": ["db:generate"]
    },
    "db:migrate:remote": {
      "cache": false,
      "dependsOn": ["db:generate"]
    }
  }
}
