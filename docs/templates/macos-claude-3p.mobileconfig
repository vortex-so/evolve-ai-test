      <key>PayloadType</key>
      <string>com.apple.ManagedClient.preferences</string>
      <!-- Replace this placeholder with a newly generated uppercase UUID. -->
      <key>PayloadUUID</key>
      <string>BBBBBBBB-BBBB-4BBB-8BBB-BBBBBBBBBBBB</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
    </dict>
  </array>
  <key>PayloadDisplayName</key>
