{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "evolve-ai-bootstrap-prod",
  "main": "src/index.tsx",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "672d1c1c2706c8738992bcd09704f6a4",
  "routes": [
    { "pattern": "api.internal.vortex.so", "custom_domain": true }
  ],
  "vars": {
    "NODE_ENV": "production",
    "PUBLIC_ORIGIN": "https://api.internal.vortex.so",
    "INFERENCE_GATEWAY_BASE_URL": "https://api.internal.vortex.so",
    "LITELLM_BASE_URL": "https://llm-manager.fly.dev",
    "LITELLM_MCP_ACCESS_GROUP": "vortex-claude-desktop",
    "ODOO_BASE_URL": "https://erp.vortex.so",
    "ODOO_MCP_ALIAS": "odoo_prod",
    "ODOO_TEST_MCP_ALIAS": "odoo_prod_test",
    "AUTH_WEB_ORIGIN": "https://auth.internal.vortex.so",
    "CONSOLE_ORIGIN": "https://console.internal.vortex.so",
    "AUTH_COOKIE_DOMAIN": ".internal.vortex.so",
    "POSTMARK_FROM": "notifications@vortex.so",
    "PRODUCT_NAME": "Vortex Auth",
    "PRODUCT_URL": "https://auth.internal.vortex.so"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "evolve-ai-bootstrap-prod",
      "database_id": "e4c2328b-9736-4748-b163-4ee272b25ceb",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    { "binding": "AUTH_KV", "id": "f553af10c95e4f6c934c524f7b5edde0" },
    { "binding": "PLUGINS_KV", "id": "1910a5e1a8df49ccb13be16a9771334d" }
  ]
}
