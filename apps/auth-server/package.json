{
  "name": "@vortex/auth-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --config wrangler.prod.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "better-auth generate --config ./src/auth.cli.ts --output ./drizzle/schema.sql --yes",
    "db:migrate:local": "wrangler d1 migrations apply evolve-ai-bootstrap-dev --local",
    "db:migrate:remote": "wrangler d1 migrations apply evolve-ai-bootstrap-dev --remote",
    "db:migrate:prod": "wrangler d1 migrations apply evolve-ai-bootstrap-prod --remote --config wrangler.prod.jsonc"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "^1.6.25",
    "@better-auth/passkey": "^1.6.25",
    "@vortex/schema": "workspace:*",
    "better-auth": "^1.6.25",
    "hono": "^4.6.14",
    "jose": "^6.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
