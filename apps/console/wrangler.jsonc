{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vortex-console-dev",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "account_id": "672d1c1c2706c8738992bcd09704f6a4",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "console.auth-dev.vortex.so",
      "custom_domain": true
    }
  ],
  "vars": {
    "NEXT_PUBLIC_AUTH_API_URL": "https://api.auth-dev.vortex.so"
  }
}
